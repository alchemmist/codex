---
source: tui/src/style.rs
expression: "[(\"ansi dark\",\nuser_message_style_for_theme_and_level(ansi.background, ansi.foreground,\nStdoutColorLevel::TrueColor,),),\n(\"github light\",\nuser_message_style_for_theme_and_level(github.background, github.foreground,\nStdoutColorLevel::TrueColor,),),]"
---
[
    (
        "ansi dark",
        Style::new().bg(Color::Rgb(30, 30, 30)),
    ),
    (
        "github light",
        Style::new().fg(Color::Rgb(51, 51, 51)).bg(Color::Rgb(244, 244, 244)),
    ),
]
